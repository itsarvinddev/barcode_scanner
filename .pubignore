# NOTE: when a .pubignore exists, pub uses it *instead of* .gitignore for this
# directory — so everything the root .gitignore excludes has to be repeated
# here, or build output ends up in the published archive.

# --- mirrors .gitignore ---
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/
*.iml
*.ipr
*.iws
.idea/
/pubspec.lock
**/doc/api/
.dart_tool/
.packages
build/
.vscode
.vsCode
.flutter-plugins
.flutter-plugins-dependencies

# --- publishing only ---
# README imagery is loaded from raw.githubusercontent.com, so it does not need
# to ship. Only the pub.dev carousel (assets/readme/pubdev_*.webp, declared
# under `screenshots:` in pubspec.yaml) has to be in the archive.
assets/readme/hero.webp
assets/readme/demo.webp
assets/readme/screen_*.webp

# Still embedded (from GitHub master) by the 8.0.1 and 8.1.0 READMEs on
# pub.dev, so it stays in the repository, but it does not need to ship.
assets/ai_barcode_scanner.png

# The generator for that imagery: a private Flutter package plus a Node
# project (with node_modules), never part of the published package.
tool/

# Machine-specific and generated files from the example app.
# The example's lockfile records whatever SDK resolved it, which would
# contradict the floor declared in pubspec.yaml for anyone reading the
# published example. `mobile_scanner` omits its example lockfile too.
example/pubspec.lock
example/android/local.properties
example/android/.gradle/
example/ios/Pods/
example/ios/.symlinks/
example/macos/Pods/
example/macos/.symlinks/
